@model IEnumerable<Rider_and_Driver.Models.Trip>

@{
	ViewData["Title"] = "My Trips";
	var bookingCounts = ViewBag.BookingCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<h1>My Trips</h1>
<p class="text-muted">All trips you've created as a driver.</p>
<hr />

@if (!Model.Any())
{
	<div class="alert alert-info">
		You haven't created any trips yet
		<a asp-action="Create">Create your first trip</a>
	</div>
}
else
{
	<table class="table table-striped">
		<thead>
			<tr>
				<th>Date</th>
				<th>Time</th>
				<th>Route</th>
				<th>Seats Left</th>
				<th>Cost</th>
				<th>Plate</th>
				<th>Bookings</th>
				<th></th>
			</tr>		
		</thead>
		<tbody>
			@foreach (var trip in Model)
			{
				var count = bookingCounts.ContainsKey(trip.TripId) ? bookingCounts[trip.TripId] : 0;
				<tr>
					<td>@trip.DepartureDate.ToString("dd MMM yyyy")</td>
					<td>@trip.DepartureTime.ToString(@"hh\:mm")</td>
					<td>@trip.FromLocation &rarr; @trip.ToLocation</td>
					<td>@trip.SeatsAvailable</td>
					<td>$@trip.Cost.ToString("F2")</td>
					<td>@trip.NumberPlate</td>
					<td>
						@if (count >0)
						{
							<span class="badge bg-primary">@count</span>
						}
						else
						{
							<span class="text-muted">0</span>
						}
						</td>
						<td>
							<a asp-action="Details" asp-route-id="@trip.TripId" class="btn btn-sm btn-outline-primary">Details</a>

							<form asp-action="Cancel" asp-route-id="@trip.TripId" method="post" class="d-inline" 
								onsubmit="return confirm('Cancel this trip? All confirmed bookings will be cancelled.');">
								<button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
							</form>
						</td>
				</tr>
			}
		</tbody>
	</table>
}