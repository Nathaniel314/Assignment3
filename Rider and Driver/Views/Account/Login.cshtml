@model Rider_and_Driver.Models.LoginViewModel

<!-- The login page and login box -->
<div class="login-page">

    <div class="login-box">

        <h1>Login</h1>

        <!-- Displays a server side error-->
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">
                @ViewBag.Error
            </div>
        }

        <!-- Form post to the account/login action -->
        <form asp-action="Login" method="post">

            <div class="mb-3">

                <!-- username feid-->
                <label asp-for="Username" class="form-label"></label>

                <input asp-for="Username"
                       class="form-control" />

                <span asp-validation-for="Username"
                      class="text-danger">
                </span>

            </div>

            <!-- Password field-->
            <div class="mb-3">

                <label asp-for="Password"
                       class="form-label">
                </label>

                <input asp-for="Password"
                       class="form-control" />

                <span asp-validation-for="Password"
                      class="text-danger">
                </span>

            </div>

            <!-- submit button and link to registry-->
            <button type="submit"
                    class="btn btn-primary">
                Login
            </button>

            <!-- Loads client side validation-->
            <a asp-controller="Account"
               asp-action="Register"
               class="ms-3">
                Register
            </a>

        </form>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}