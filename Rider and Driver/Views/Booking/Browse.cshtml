@model IEnumerable<Rider_and_Driver.Models.Trip>

@{
	ViewData["Title"] = "Browse Trips";
	var bookedTripIds = ViewBag.BookedTripIds as List<int> ?? new List<int>();
}

<h1>Available Trips</h1>
<p class="text-muted">Find a ride and book your seat.</p>
<hr />

@if (!Model.Any())
{
	<div class="alert alert-info">No trips avalible right now. Please check back later</div>
}
else
{
	<table class="table table-striped">
		<thread>
			<tr>
				<th>Date</th>
				<th>Time</th>
				<th>From</th>
				<th>To</th>
				<th>Driver</th>
				<th>Seats Left</th>
				<th>Cost</th>
				<th>Plate</th>			
			</tr>		
		</thread>
		<tbody>
			@foreach (var trip in Model)
			{
				var alreadyBooked = bookedTripIds.Contains(trip.TripId);
				<tr>
					<td>@trip.DepartureDate.ToString("dd MMM yyyy")</td>
					<td>@trip.DepartureTime.ToString(@"hh\:mm")</td>
					<td>@trip.FromLocation</td>
					<td>@trip.ToLocation</td>
					<td>@(trip.Driver?.Username ?? "-")</td>
					<td>@trip.SeatsAvailable</td>
					<td>@trip.Cost.ToString("F2")</td>
					<td>@trip.NumberPlate</td>
					<td>
						@if (alreadyBooked)
						{
							<span class="badge bg-success">Booked</span>
						}
						else
						{
							<a asp-action="Book" asp-route-id="@trip.TripId" class="btn btn-sm btn-primary">Book</a>
						}
					</td>
				</tr>
			}		
		</tbody>
	</table>
}