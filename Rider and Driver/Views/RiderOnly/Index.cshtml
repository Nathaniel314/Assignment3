@model IEnumerable<Rider_and_Driver.Models.Trip>

<div class="rider-home">

    <div class="driver-content">

        <h1>Rider Homepage</h1>

        <p>Welcome, Rider!</p>


        <!-- Calendar -->

        <div class="calendar-box">

            <div class="calendar">

                <div class="calendar-header">

                    <button type="button"
                            id="prevMonth">
                        &lt;
                    </button>

                    <h2 id="monthYear"></h2>

                    <button type="button"
                            id="nextMonth">
                        &gt;
                    </button>

                </div>


                <div class="calendar-weekdays">

                    <div>Mo</div>
                    <div>Tu</div>
                    <div>We</div>
                    <div>Th</div>
                    <div>Fr</div>
                    <div>Sa</div>
                    <div>Su</div>

                </div>


                <div class="calendar-days"
                     id="calendarDays">
                </div>

            </div>

        </div>


        <!-- Available Rides -->

        <div class="rider-rides-box">

            <h2>Available Rides</h2>


            <!-- Search and Filter -->

            <h3>Sort Ride and Order</h3>

            <form asp-controller="RiderOnly"
                  asp-action="Index"
                  method="get">

                <!-- Keep the selected calendar date -->
                <input type="hidden"
                       name="date"
                       value="@ViewBag.SelectedDate.ToString("yyyy-MM-dd")" />

                <!-- Search: Depart From -->

                <div>
                    <label>Depart From</label>

                    <input type="text"
                        name="FromLocation"
                        value="@ViewBag.FromLocation"
                        placeholder="Departure" />

                </div>


                <!-- Search: Going To -->

                <div>
                    <label>Going To</label>

                    <input type="text"
                        name="ToLocation"
                        value="@ViewBag.ToLocation"
                        placeholder="Destination" />

                </div>


                <div>
                    <label>Sort By</label>

                    <select name="SortBy">

                        <option value=""
                                selected="@(ViewBag.SortBy == "" || ViewBag.SortBy == null)">
                            Departure Time
                        </option>

                        <option value="Cost"
                                selected="@(ViewBag.SortBy == "Cost")">
                            Cost
                        </option>

                        <option value="SeatsAvailable"
                                selected="@(ViewBag.SortBy == "SeatsAvailable")">
                            Seats Available
                        </option>

                    </select>

                </div>


                <div>
                    <label>Order</label>

                    <select name="SortOrder">

                        <option value="Ascending"
                                selected="@(ViewBag.SortOrder == "Ascending" || ViewBag.SortOrder == null)">
                            Lowest / Earliest
                        </option>

                        <option value="Descending"
                                selected="@(ViewBag.SortOrder == "Descending")">
                            Highest / Latest
                        </option>

                    </select>

                </div>


                <button type="submit">
                    Apply
                </button>

            </form>
            <p>
                Rides for:

                <strong>
                    @ViewBag.SelectedDate.ToString(
                             "dd MMMM yyyy")
                </strong>
            </p>


            @if (!Model.Any())
            {
                <p>
                    No rides available for this date.
                </p>
            }
            else
            {
                foreach (var ride in Model)
                {
                    <div class="ride-card">

                        <h3>
                            @(ride.Driver != null
                                ? ride.Driver.Username
                                : "Driver")
                        </h3>


                        <p>
                            <strong>From:</strong>
                            @ride.FromLocation
                        </p>


                        <p>
                            <strong>To:</strong>
                            @ride.ToLocation
                        </p>


                        <p>
                            <strong>Time:</strong>
                            @ride.DepartureTime.ToString(
                                     @"hh\:mm")
                        </p>


                        <p>
                            <strong>Seats:</strong>
                            @ride.SeatsAvailable
                        </p>


                        <p>
                            <strong>Price:</strong>
                            $@ride.Cost
                        </p>


                        <!-- SAME RAZOR FORM STYLE AS DRIVER -->

                        <form asp-controller="Booking"
                              asp-action="Book"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="tripId"
                                   value="@ride.TripId" />

                            <button type="submit"
                                    class="btn btn-primary">

                                Book Ride

                            </button>

                        </form>

                    </div>
                }
            }

        </div>

    </div>

</div>


@section Scripts {

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                let currentDate = new Date();

                const monthYear =
                    document.getElementById(
                        "monthYear"
                    );

                const calendarDays =
                    document.getElementById(
                        "calendarDays"
                    );

                const prevMonth =
                    document.getElementById(
                        "prevMonth"
                    );

                const nextMonth =
                    document.getElementById(
                        "nextMonth"
                    );


                const months = [
                    "January",
                    "February",
                    "March",
                    "April",
                    "May",
                    "June",
                    "July",
                    "August",
                    "September",
                    "October",
                    "November",
                    "December"
                ];


                function createCalendar() {

                    calendarDays.innerHTML = "";

                    const year =
                        currentDate.getFullYear();

                    const month =
                        currentDate.getMonth();


                    monthYear.textContent =
                        months[month] +
                        " " +
                        year;


                    let firstDay =
                        new Date(
                            year,
                            month,
                            1
                        ).getDay();


                    firstDay =
                        firstDay === 0
                            ? 6
                            : firstDay - 1;


                    const daysInMonth =
                        new Date(
                            year,
                            month + 1,
                            0
                        ).getDate();


                    // Empty spaces

                    for (
                        let i = 0;
                        i < firstDay;
                        i++
                    ) {

                        const emptyDay =
                            document.createElement(
                                "div"
                            );

                        emptyDay.classList.add(
                            "calendar-day",
                            "empty"
                        );

                        calendarDays.appendChild(
                            emptyDay
                        );
                    }


                    // Days

                    for (
                        let day = 1;
                        day <= daysInMonth;
                        day++
                    ) {

                        const dayElement =
                            document.createElement(
                                "div"
                            );


                        dayElement.classList.add(
                            "calendar-day"
                        );


                        dayElement.textContent =
                            day;


                        dayElement.addEventListener(
                            "click",
                            function () {

                                const monthNumber =
                                    String(
                                        month + 1
                                    ).padStart(
                                        2,
                                        "0"
                                    );


                                const dayNumber =
                                    String(day)
                                        .padStart(
                                            2,
                                            "0"
                                        );


                                const dateValue =
                                    year +
                                    "-" +
                                    monthNumber +
                                    "-" +
                                    dayNumber;


                                /*
                                 * Reload the page
                                 * using the selected date.
                                 */

                                window.location.href =
                                    "/RiderOnly/Index?date=" +
                                    dateValue;

                            }
                        );


                        calendarDays.appendChild(
                            dayElement
                        );

                    }

                }


                // Previous month

                prevMonth.addEventListener(
                    "click",
                    function () {

                        currentDate.setMonth(
                            currentDate.getMonth() - 1
                        );

                        createCalendar();

                    }
                );


                // Next month

                nextMonth.addEventListener(
                    "click",
                    function () {

                        currentDate.setMonth(
                            currentDate.getMonth() + 1
                        );

                        createCalendar();

                    }
                );


                createCalendar();

            }
        );

    </script>

}