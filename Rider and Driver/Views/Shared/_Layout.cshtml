<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Rider_and_Driver</title>

    <link rel="stylesheet" href="~/css/BootStrap.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Rider_and_Driver.styles.css" asp-append-version="true" />
</head>

<body class="site-body">

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger mb-0 rounded-0 text-center">
            @TempData["Error"]
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success mb-0 rounded-0 text-center">
            @TempData["Success"]
        </div>
    }

    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow">

            <div class="container-fluid">

                @if (Context.Session.GetString("Role") == "Driver")
                {
                    <a class="navbar-brand"
                       asp-controller="DriverOnly"
                       asp-action="Index">
                        <img src="~/css/logo.png"
                            alt="Rider and Driver"
                            class="navbar-logo" />
                    </a>
                }
                else if (Context.Session.GetString("Role") == "Rider")
                {
                    <a class="navbar-brand"
                       asp-controller="RiderOnly"
                       asp-action="Index">
                        <img src="~/css/logo.png"
                            alt="Rider and Driver"
                            class="navbar-logo" />
                    </a>
                }
                else
                {
                    <a class="navbar-brand"
                       asp-controller="Home"
                       asp-action="Index">
                        <img src="~/css/logo.png"
                            alt="Rider and Driver"
                            class="navbar-logo" />
                    </a>
                }

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    @* Driver Navbar *@
                    @if (Context.Session.GetString("Role") == "Driver")
                    {
                        <ul class="navbar-nav flex-grow-1">

                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="DriverOnly"
                                   asp-action="Index">
                                    Homepage
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="Trip"
                                   asp-action="Index">
                                    My Trips
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="History"
                                   asp-action="Index">
                                    History
                                </a>
                            </li>

                        </ul>
                    }

                    @* Rider navbar *@
                    else if (Context.Session.GetString("Role") == "Rider")
                    {
                        <ul class="navbar-nav flex-grow-1">

                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="RiderOnly"
                                   asp-action="Index">
                                    Homepage
                                </a>
                            </li>


                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="Booking"
                                   asp-action="MyBookings">
                                    My Bookings
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="History"
                                   asp-action="Index">
                                    History
                                </a>
                            </li>

                        </ul>
                    }

                    @* USER SECTION *@
                    <ul class="navbar-nav">

                        @if (Context.Session.GetString("Username") != null)
                        {
                            <li class="nav-item">

                                <span class="nav-link text-dark">
                                    Hello, @Context.Session.GetString("Username")!
                                </span>

                            </li>

                            <li class="nav-item">

                                <form asp-controller="Account"
                                      asp-action="Logout"
                                      method="post"
                                      class="d-inline">

                                    <button type="submit"
                                            class="nav-link text-dark btn btn-link">
                                        Logout
                                    </button>

                                </form>

                            </li>
                        }
                        else
                        {
                            <li class="nav-item">

                                <a class="nav-link text-dark"
                                   asp-controller="Account"
                                   asp-action="Login">
                                    Login
                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link text-dark"
                                   asp-controller="Account"
                                   asp-action="Register">
                                    Register
                                </a>

                            </li>
                        }

                    </ul>

                </div>
            </div>
        </nav>
    </header>


    @* PAGE CONTENT *@
    <main role="main" class="pb-3">
        @RenderBody()
    </main>


    @* FOOTER *@
    <footer class="border-top footer text-muted">

        <div class="container">
            &copy; 2026 - Rider_and_Driver
        </div>

    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

   <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>


    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>