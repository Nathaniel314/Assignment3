```cshtml
@model IEnumerable<Rider_and_Driver.Models.Trip>

<!-- Main container for the Rider Homepage -->
<div class="rider-home">

    <div class="driver-content">

        <!-- Display the Rider Homepage heading and welcome message -->
        <h1>Rider Homepage</h1>
        <p>Welcome, Rider!</p>

        <!-- Calendar section for selecting the date on which the rider wants to travel -->
        <div class="calendar-box">

            <div class="calendar">

                <!-- Calendar header with previous month, current month and next month -->
                <div class="calendar-header">

                    <!-- Button to display the previous month -->
                    <button type="button" id="prevMonth">
                        &lt;
                    </button>

                    <!-- JavaScript displays the current month and year here -->
                    <h2 id="monthYear"></h2>

                    <!-- Button to display the next month -->
                    <button type="button" id="nextMonth">
                        &gt;
                    </button>

                </div>

                <!-- Display weekday headings, starting with Monday -->
                <div class="calendar-weekdays">
                    <div>Mo</div>
                    <div>Tu</div>
                    <div>We</div>
                    <div>Th</div>
                    <div>Fr</div>
                    <div>Sa</div>
                    <div>Su</div>
                </div>

                <!-- JavaScript generates the dates for the selected month inside this container -->
                <div class="calendar-days" id="calendarDays">
                </div>

            </div>

        </div>

        <!-- Section displaying rides available for the selected date -->
        <div class="rider-rides-box">

            <h2>Available Rides</h2>

            <!-- Search and filtering section for finding suitable rides -->
            <h3>Search/Filter Ride Sort</h3>

            <!-- Submit search and sorting options to the RiderOnly Index action using GET -->
            <form asp-controller="RiderOnly"
                  asp-action="Index"
                  method="get">

                <!-- Preserve the currently selected calendar date when applying filters -->
                <input type="hidden"
                       name="date"
                       value="@ViewBag.SelectedDate.ToString("yyyy-MM-dd")" />

                <!-- Search rides by their departure location -->
                <div>
                    <label>Search: Depart From</label>

                    <!-- Keep the previously entered departure location in the search field -->
                    <input type="text"
                           name="FromLocation"
                           value="@ViewBag.FromLocation"
                           placeholder="Departure" />
                </div>

                <!-- Search rides by their destination -->
                <div>
                    <label>Search: Going To</label>

                    <!-- Keep the previously entered destination in the search field -->
                    <input type="text"
                           name="ToLocation"
                           value="@ViewBag.ToLocation"
                           placeholder="Destination" />
                </div>

                <!-- Choose which ride property to use for sorting -->
                <div>
                    <label>Filter</label>

                    <!-- The parameter name is SortBy because this is what the controller receives -->
                    <select name="SortBy">

                        <!-- Use departure time as the default sorting option -->
                        <option value=""
                                selected="@(ViewBag.SortBy == "" || ViewBag.SortBy == null)">
                            Departure Time
                        </option>

                        <!-- Sort rides by their cost -->
                        <option value="Cost"
                                selected="@(ViewBag.SortBy == "Cost")">
                            Cost
                        </option>

                        <!-- Sort rides by the number of available seats -->
                        <option value="SeatsAvailable"
                                selected="@(ViewBag.SortBy == "SeatsAvailable")">
                            Seats Available
                        </option>

                    </select>
                </div>

                <!-- Choose whether results should be displayed in ascending or descending order -->
                <div>
                    <label>Sort</label>

                    <select name="SortOrder">

                        <!-- Display lower costs, earlier times or fewer seats first,
                             depending on the selected sorting property -->
                        <option value="Ascending"
                                selected="@(ViewBag.SortOrder == "Ascending" || ViewBag.SortOrder == null)">
                            Lowest / Earliest
                        </option>

                        <!-- Display higher costs, later times or more seats first,
                             depending on the selected sorting property -->
                        <option value="Descending"
                                selected="@(ViewBag.SortOrder == "Descending")">
                            Highest / Latest
                        </option>

                    </select>
                </div>

                <!-- Submit the search and sorting options -->
                <button type="submit">
                    Apply
                </button>

            </form>

            <!-- Display the date for which rides are being shown -->
            <p>
                Rides for:

                <strong>
                    @ViewBag.SelectedDate.ToString("dd MMMM yyyy")
                </strong>
            </p>

            <!-- Check whether any rides are available for the selected date -->
            @if (!Model.Any())
            {
                <!-- Display a message when no rides match the current results -->
                <p>
                    No rides available for this date.
                </p>
            }
            else
            {
                <!-- Loop through and display each available ride -->
                foreach (var ride in Model)
                {
                    <div class="ride-card">

                        <!-- Display the driver's username when driver information is available -->
                        <h3>
                            @(ride.Driver != null
                                ? ride.Driver.Username
                                : "Driver")
                        </h3>

                        <!-- Display the ride's departure location -->
                        <p>
                            <strong>From:</strong>
                            @ride.FromLocation
                        </p>

                        <!-- Display the ride's destination -->
                        <p>
                            <strong>To:</strong>
                            @ride.ToLocation
                        </p>

                        <!-- Display the departure time in hours and minutes -->
                        <p>
                            <strong>Time:</strong>
                            @ride.DepartureTime.ToString(@"hh\:mm")
                        </p>

                        <!-- Display the number of seats still available -->
                        <p>
                            <strong>Seats:</strong>
                            @ride.SeatsAvailable
                        </p>

                        <!-- Display the price per seat -->
                        <p>
                            <strong>Price:</strong>
                            $@ride.Cost
                        </p>

                        <!-- Booking form for the selected ride -->
                        <!-- Submit the booking request to the Book action in BookingController -->
                        <form asp-controller="Booking"
                              asp-action="Book"
                              method="post">

                            <!-- Generate an anti-forgery token to help protect the form against CSRF attacks -->
                            @Html.AntiForgeryToken()

                            <!-- Pass the selected ride's ID to the booking action -->
                            <input type="hidden"
                                   name="tripId"
                                   value="@ride.TripId" />

                            <!-- Submit the request to book this ride -->
                            <button type="submit" class="btn btn-primary">
                                Book Ride
                            </button>

                        </form>

                    </div>
                }
            }

        </div>

    </div>

</div>

@section Scripts {

    <script>

        // Wait until the page's HTML has loaded before accessing calendar elements
        document.addEventListener(
            "DOMContentLoaded",
            function () {

                // Store the date currently displayed by the calendar
                let currentDate = new Date();

                // Get the HTML element used to display the month and year
                const monthYear =
                    document.getElementById("monthYear");

                // Get the container where calendar dates will be generated
                const calendarDays =
                    document.getElementById("calendarDays");

                // Get the button used to navigate to the previous month
                const prevMonth =
                    document.getElementById("prevMonth");

                // Get the button used to navigate to the next month
                const nextMonth =
                    document.getElementById("nextMonth");

                // Store month names for displaying the calendar heading
                const months = [
                    "January",
                    "February",
                    "March",
                    "April",
                    "May",
                    "June",
                    "July",
                    "August",
                    "September",
                    "October",
                    "November",
                    "December"
                ];

                // Generate the calendar for the month stored in currentDate
                function createCalendar() {

                    // Clear previously generated dates before creating the new calendar
                    calendarDays.innerHTML = "";

                    // Get the year and month currently being displayed
                    const year =
                        currentDate.getFullYear();

                    const month =
                        currentDate.getMonth();

                    // Display the current month name and year in the calendar heading
                    monthYear.textContent =
                        months[month] + " " + year;

                    // Find the weekday number of the first day of the month
                    // JavaScript numbers Sunday as 0 and Monday as 1
                    let firstDay =
                        new Date(year, month, 1).getDay();

                    // Adjust the weekday number so Monday becomes the first day of the week
                    // Sunday is moved to position 6
                    firstDay =
                        firstDay === 0
                            ? 6
                            : firstDay - 1;

                    // Calculate how many days the current month contains
                    const daysInMonth =
                        new Date(year, month + 1, 0).getDate();

                    // Add empty calendar cells before the first day of the month
                    // to align dates with their correct weekdays
                    for (
                        let i = 0;
                        i < firstDay;
                        i++
                    ) {

                        // Create an empty calendar cell
                        const emptyDay =
                            document.createElement("div");

                        // Apply CSS classes to identify the cell as an empty calendar space
                        emptyDay.classList.add(
                            "calendar-day",
                            "empty"
                        );

                        // Add the empty cell to the calendar
                        calendarDays.appendChild(emptyDay);
                    }

                    // Generate a calendar cell for each day in the current month
                    for (
                        let day = 1;
                        day <= daysInMonth;
                        day++
                    ) {

                        // Create a new HTML element for the date
                        const dayElement =
                            document.createElement("div");

                        // Apply the CSS class used to style calendar dates
                        dayElement.classList.add("calendar-day");

                        // Display the day number inside the calendar cell
                        dayElement.textContent = day;

                        // Add a click event so the rider can select a travel date
                        dayElement.addEventListener(
                            "click",
                            function () {

                                // Convert the month number into two digits
                                // JavaScript months start at 0, so add 1
                                const monthNumber =
                                    String(month + 1).padStart(2, "0");

                                // Convert the selected day into two digits
                                const dayNumber =
                                    String(day).padStart(2, "0");

                                // Format the selected date as YYYY-MM-DD
                                // This format is passed to the controller
                                const dateValue =
                                    year +
                                    "-" +
                                    monthNumber +
                                    "-" +
                                    dayNumber;

                                /*
                                 * Reload the Rider Homepage with the selected date.
                                 * The date is passed through the URL query string
                                 * to the Index action in RiderOnlyController.
                                 */

                                window.location.href =
                                    "/RiderOnly/Index?date=" +
                                    dateValue;

                            }
                        );

                        // Add the completed date cell to the calendar
                        calendarDays.appendChild(dayElement);

                    }

                }

                // Handle clicks on the previous-month button
                prevMonth.addEventListener(
                    "click",
                    function () {

                        // Move the displayed date back by one month
                        currentDate.setMonth(
                            currentDate.getMonth() - 1
                        );

                        // Regenerate the calendar for the previous month
                        createCalendar();

                    }
                );

                // Handle clicks on the next-month button
                nextMonth.addEventListener(
                    "click",
                    function () {

                        // Move the displayed date forward by one month
                        currentDate.setMonth(
                            currentDate.getMonth() + 1
                        );

                        // Regenerate the calendar for the next month
                        createCalendar();

                    }
                );

                // Generate the calendar when the page loads
                createCalendar();

            }
        );

    </script>

}
```