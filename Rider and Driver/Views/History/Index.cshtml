@model IEnumerable<Rider_and_Driver.Models.Booking>

@{
	ViewData["Title"] = "Transaction History";
	var role = ViewBag.Role as string;
	var isRider = role == "Rider";
}

<h1>Transaction History</h1>
<p class="text-muted">
	@if (isRider)
	{
	<span>Every booking you've made</span>
	}
	else
	{
	<span>Every booking made on your trips</span>
	}
</p>
<hr />

@*Summary Card*@
@if (isRider)
{
	<div class="alert alert-info">
		<strong>Total spent:</strong> $@(((decimal)(ViewBag.TotalSpent ?? 0m)).ToString("F2"))
	</div> 
}
else
{
	<div class="alert alert-success">
		<strong>Total earned:</strong> $@(((decimal)(ViewBag.TotalEarned ?? 0m)).ToString("F2"))
	</div>
}

@*Empty state*@
@if(!Model.Any())
{
	<div class="alert alert-secondary">
		@if(isRider)
		{
			<span>You haven't made any bookings yet.</span>
		}
		else
		{
			<span>No Bookings have been made on your trips yet</span>
		}
	</div>
}
else
{
	<table class="table table-striped">
		<thead>
			<tr>
				<th>Booked On</th>
				@if (isRider)
				{
					<th>Driver</th>
				}
				else
				{
					<th>Rider</th>
				}
				<th>Route</th>
				<th>Trip Date</th>
				<th>Cost</th>
				<th>Status</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var booking in Model)
			{
				<tr>
					<td>@booking.BookedAt.ToString("dd MMM yyyy HH:mm")</td>

					@if (isRider)
					{
						<td>@(booking.Trip?.Driver?.Username ?? "-")</td>
					}
					else
					{
						<td>@(booking.Rider?.Username ?? "-")</td>
					}
					<td>
						@if (booking.Trip != null)
						{
							@booking.Trip.FromLocation
							@: &rarr;
							@booking.Trip.ToLocation
						}
						else
						{
							@:-
						}
					</td>
					<td>
						@if (booking.Trip != null)
						{
							@($"{booking.Trip.DepartureDate:dd MMM yyyy} {booking.Trip.DepartureTime:hh\\:mm}")
						}
						else
						{
							<text>-</text>
						}
					</td>
					<td>$@booking.TotalCost.ToString("F2")</td>
					<td>
						@if (booking.Status == "Confirmed")
						{
							<span class="badge bg-success">Confirmed</span>
						}
						else
						{
							<span class="badge bg-secondary">Cancelled</span>
						}
					</td>
				</tr>
			}
		</tbody>
	</table>
}