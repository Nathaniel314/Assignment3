@model Rider_and_Driver.Models.Trip

@{
	ViewData["Title"] = "Confirm Booking";
}

<h1>Available Trips</h1>
<hr />

<div class="card" style="max-width: 600px;">
	<div class="card-body">
		<h4>
			@Model.FromLocation &rArr; @Model.ToLocation
		</h4>
		<p class="card-text">
			<strong>Date:</strong> @Model.DepartureDate.ToString("dd MMM yyyy")<br />
			<strong>Time:</strong> @Model.DepartureTime.ToString(@"hh\:mm")<br />
			<strong>Driver:</strong> @(Model.Driver?.Username ?? "-")<br />
			<strong>Number Plate:</strong> @Model.NumberPlate<br />
			<strong>Seat Left:</strong> @Model.SeatsAvailable<br />
			<strong>Cost per Seat</strong> @Model.Cost.ToString("F2")<br />
		</p>

		<hr />

		<form asp-action="Book" asp-route-itemid="@Model.TripId" method="post">
			<button type="submit" class="btn btn-success">Confirm Booking</button>
			<a asp-action="Browse" class="btn btn-secondary">Back to Browse</a>
		</form>
	</div>	
</div>
